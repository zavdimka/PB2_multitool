#!/bin/sh

case "$1" in
    start)
        start-stop-daemon -S -b -m -p /run/multitool/ui.pid \
            -x /usr/bin/multitool-ui-launch
        ;;
    stop)
        start-stop-daemon -K -p /run/multitool/ui.pid
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac