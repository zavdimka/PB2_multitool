From 6f4ed4501313831b66622db0ac6fbdbdb38c5869 Mon Sep 17 00:00:00 2001
From: PB2 Multitool <pb2-multitool@local>
Date: Thu, 8 Oct 2026 12:00:00 +0000
Subject: [PATCH] arm64: dts: ti: add BB2 multitool pinmux

Configure the PocketBeagle 2 cape headers for the BB2_multitool board.
The PRU data and direction assignments follow the schematic net names.
IO0..IO7 default to PRU1 output mode, IO8..IO11 to PRU0 input mode; the
matching direction lines remain PRU outputs.

Reuse the existing SPI0, I2C2 and UART0 definitions, enable SPI2 and I2C3,
and instantiate the ADS8688A on SPI2 chip select zero.

Signed-off-by: PB2 Multitool <pb2-multitool@local>
---
 .../boot/dts/ti/k3-am62-pocketbeagle2.dts     |   1 +
 .../ti/k3-am62-pocketbeagle2-multitool.dtsi   | 161 ++++++++++++++++++
 2 files changed, 162 insertions(+)
 create mode 100644 arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2-multitool.dtsi

diff --git a/arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2.dts b/arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2.dts
index 57eb779451ec..a6bf5e709aad 100644
--- a/arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2.dts
+++ b/arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2.dts
@@ -496,3 +496,4 @@
 };
 
 #include "k3-am62-ti-ipc-firmware.dtsi"
+#include "k3-am62-pocketbeagle2-multitool.dtsi"
diff --git a/arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2-multitool.dtsi b/arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2-multitool.dtsi
new file mode 100644
index 000000000000..72ae19c1ed88
--- /dev/null
+++ b/arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2-multitool.dtsi
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* BB2_multitool cape pinmux for PocketBeagle 2. */
+
+&main_pmx0 {
+	pb2_multitool_pru0_pins: pb2-multitool-pru0-pins {
+		pinctrl-single,pins = <
+			/* Translated data: IO8, IO9, IO10 and IO11. */
+			AM62X_IOPAD(0x00b8, PIN_INPUT, 6) /* P2.02: PRU0 GPI8 / IO8 */
+			AM62X_IOPAD(0x00d8, PIN_INPUT, 6) /* P2.18: PRU0 GPI17 / IO9 */
+			AM62X_IOPAD(0x00fc, PIN_INPUT, 6) /* P1.29: PRU0 GPI7 / IO10 */
+			AM62X_IOPAD(0x00e4, PIN_INPUT, 6) /* P1.33A: PRU0 GPI1 / IO11 */
+
+			/* 74LVC1T45 direction controls for IO8..IO11. */
+			AM62X_IOPAD(0x00bc, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 5) /* P2.04: PRU0.9 */
+			AM62X_IOPAD(0x0100, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 5) /* P2.22: PRU0.18 */
+			AM62X_IOPAD(0x00c8, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 5) /* P2.20: PRU0.12 */
+			AM62X_IOPAD(0x00f0, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 5) /* P1.31: PRU0.4 */
+
+			/* P1.33 has two shorted SoC balls; use AA23 only. */
+			AM62X_IOPAD(0x01ec, PIN_DISABLE, 7) /* P1.33/A17 disabled */
+		>;
+	};
+
+	pb2_multitool_pru1_pins: pb2-multitool-pru1-pins {
+		pinctrl-single,pins = <
+			/* Translated data: IO0..IO7. */
+			AM62X_IOPAD(0x00c4, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P2.08: PRU1.3 */
+			AM62X_IOPAD(0x00d0, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P2.24: PRU1.6 */
+			AM62X_IOPAD(0x00ec, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P2.30: PRU1.12 */
+			AM62X_IOPAD(0x00f4, PIN_INPUT | PIN_DRIVE_STRENGTH_NOMINAL, 3) /* P2.34: PRU1 GPI14 / JTAG TDO */
+			AM62X_IOPAD(0x0178, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 3) /* P2.19: PRU1.16 */
+			AM62X_IOPAD(0x00dc, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P2.35: PRU1.8 */
+			AM62X_IOPAD(0x0164, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 3) /* P1.02A: PRU1.0 */
+			AM62X_IOPAD(0x0168, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 3) /* P1.35: PRU1.1 */
+
+			/* 74LVC1T45 direction controls for IO0..IO7. */
+			AM62X_IOPAD(0x00c0, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P2.06: PRU1.2 */
+			AM62X_IOPAD(0x0174, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 3) /* P2.10: PRU1.4 */
+			AM62X_IOPAD(0x00f8, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P2.28: PRU1.15 */
+			AM62X_IOPAD(0x00e8, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P2.32: PRU1.11 */
+			AM62X_IOPAD(0x0104, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P2.17: PRU1.19 */
+			AM62X_IOPAD(0x00d4, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P2.33: PRU1.7 */
+			AM62X_IOPAD(0x00cc, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P1.20: PRU1.5 */
+			AM62X_IOPAD(0x00e0, PIN_OUTPUT | PIN_DRIVE_STRENGTH_NOMINAL, 2) /* P1.36: PRU1.9 */
+
+			/* P1.02 and P1.36 have two shorted SoC balls. */
+			AM62X_IOPAD(0x01a0, PIN_DISABLE, 7) /* P1.02/E18 disabled */
+			AM62X_IOPAD(0x01e8, PIN_DISABLE, 7) /* P1.36A/B17 disabled */
+		>;
+	};
+
+	pb2_multitool_spi2_pins: pb2-multitool-spi2-pins {
+		pinctrl-single,pins = <
+			AM62X_IOPAD(0x01ac, PIN_OUTPUT, 1) /* P1.06: SPI2_CS0 / SPI_CS1 */
+			AM62X_IOPAD(0x01b0, PIN_OUTPUT, 1) /* P1.08: SPI2_CLK / SPI_CLK */
+			AM62X_IOPAD(0x0194, PIN_INPUT, 1)  /* P1.10: SPI2_D0 / SPI_MISO */
+			AM62X_IOPAD(0x0198, PIN_OUTPUT, 1) /* P1.12: SPI2_D1 / SPI_MOSI */
+			AM62X_IOPAD(0x01f0, PIN_DISABLE, 7) /* P1.10A/A18 disabled */
+			AM62X_IOPAD(0x013c, PIN_DISABLE, 7) /* P1.12A/AE18 disabled */
+		>;
+	};
+
+	pb2_multitool_i2c3_pins: pb2-multitool-i2c3-pins {
+		pinctrl-single,pins = <
+			AM62X_IOPAD(0x01d0, PIN_INPUT_PULLUP, 2) /* P2.09: I2C3_SCL */
+			AM62X_IOPAD(0x01d4, PIN_INPUT_PULLUP, 2) /* P2.11: I2C3_SDA */
+		>;
+	};
+
+	pb2_multitool_gpio_pins: pb2-multitool-gpio-pins {
+		pinctrl-single,pins = <
+			AM62X_IOPAD(0x01a8, PIN_INPUT_PULLDOWN, 7) /* P1.04/D20: PULL_4_5 */
+			AM62X_IOPAD(0x016c, PIN_DISABLE, 7) /* P1.04A/Y18 disabled */
+			AM62X_IOPAD(0x0190, PIN_INPUT_PULLDOWN, 7) /* P1.21: SPI0_RESET */
+			AM62X_IOPAD(0x01d8, PIN_INPUT_PULLUP, 7)   /* P2.05: GPIO1_24 / TP_INT */
+			AM62X_IOPAD(0x018c, PIN_INPUT_PULLDOWN, 7) /* P1.23: SPI0_RS */
+			AM62X_IOPAD(0x0188, PIN_INPUT_PULLDOWN, 7) /* P1.25: PULL_10_11 */
+			AM62X_IOPAD(0x0184, PIN_INPUT_PULLDOWN, 7) /* P1.27: PULL_8_9 */
+			AM62X_IOPAD(0x0180, PIN_INPUT_PULLDOWN, 7) /* P1.34: PULL_6_7 */
+			AM62X_IOPAD(0x01b8, PIN_INPUT_PULLDOWN, 7) /* P2.36: LED */
+		>;
+	};
+
+	pb2_multitool_spi0_short_disable_pins: pb2-multitool-spi0-short-disable-pins {
+		pinctrl-single,pins = <
+			AM62X_IOPAD(0x00a4, PIN_DISABLE, 7) /* P2.29A/M22 disabled */
+			AM62X_IOPAD(0x0170, PIN_DISABLE, 7) /* P2.31A/AA18 disabled */
+		>;
+	};
+};
+
+&mcu_pmx0 {
+	pb2_multitool_mcu_short_disable_pins: pb2-multitool-mcu-short-disable-pins {
+		pinctrl-single,pins = <
+			AM62X_MCU_IOPAD(0x0014, PIN_DISABLE, 7) /* P2.05A/B5 disabled */
+			AM62X_MCU_IOPAD(0x0034, PIN_DISABLE, 7) /* P1.26A/D6 disabled */
+			AM62X_MCU_IOPAD(0x0038, PIN_DISABLE, 7) /* P1.28A/B3 disabled */
+			AM62X_MCU_IOPAD(0x0040, PIN_DISABLE, 7) /* P2.09A/D4 disabled */
+			AM62X_MCU_IOPAD(0x003c, PIN_DISABLE, 7) /* P2.11A/E5 disabled */
+		>;
+	};
+};
+
+&pru0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pb2_multitool_pru0_pins>;
+	status = "okay";
+};
+
+&pru1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pb2_multitool_pru1_pins>;
+	status = "okay";
+};
+
+&main_uart1 {
+	status = "disabled";
+};
+
+&main_i2c1 {
+	status = "disabled";
+};
+
+&epwm2 {
+	status = "disabled";
+};
+
+&main_i2c2 {
+	pinctrl-0 = <&main_i2c2_pins_default
+		     &pb2_multitool_mcu_short_disable_pins>;
+};
+
+&main_i2c3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pb2_multitool_i2c3_pins
+		     &pb2_multitool_mcu_short_disable_pins>;
+	clock-frequency = <400000>;
+	status = "okay";
+};
+
+&main_spi0 {
+	pinctrl-0 = <&main_spi0_pins_default
+		     &pb2_multitool_spi0_short_disable_pins>;
+};
+
+&main_spi2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pb2_multitool_spi2_pins>;
+	status = "okay";
+
+	ads8688: adc@0 {
+		compatible = "ti,ads8688";
+		reg = <0>;
+		spi-max-frequency = <16000000>;
+	};
+};
+
+&main_gpio1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pb2_multitool_gpio_pins>;
+};
-- 
2.47.3

