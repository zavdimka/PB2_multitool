From 2df4cf0bd17d02cc09e6745f7741d48b9e6a7c52 Mon Sep 17 00:00:00 2001
From: PB2 Multitool <pb2-multitool@local>
Date: Thu, 8 Oct 2026 20:20:00 +0000
Subject: [PATCH] arm64: dts: ti: add LCDWiki MSP4031 display and touch

Use the generic MIPI DBI panel driver for the 320x480 ST7796S and the
existing FocalTech FT6236-compatible path for the two-touch FT6336U.
The board ties LCD_RST and CTP_RST together, so the display owns the
shared reset while the touch controller uses its power-on reset.

Signed-off-by: PB2 Multitool <pb2-multitool@local>
---
 .../panel/panel-mipi-dbi-spi.yaml              |  1 +
 .../ti/k3-am62-pocketbeagle2-multitool.dtsi    | 44 +++++++++++++++++++
 2 files changed, 45 insertions(+)

--- a/Documentation/devicetree/bindings/display/panel/panel-mipi-dbi-spi.yaml
+++ b/Documentation/devicetree/bindings/display/panel/panel-mipi-dbi-spi.yaml
@@ -72,6 +72,7 @@ properties:
   compatible:
     items:
       - enum:
+          - lcdwiki,msp4031
           - saef,sftc154b
           - sainsmart18
           - shineworld,lh133k
--- a/arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2-multitool.dtsi
+++ b/arch/arm64/boot/dts/ti/k3-am62-pocketbeagle2-multitool.dtsi
@@ -1,6 +1,14 @@
 // SPDX-License-Identifier: GPL-2.0-only OR MIT
 /* BB2_multitool cape pinmux for PocketBeagle 2. */
 
+/ {
+	msp4031_backlight: backlight {
+		compatible = "gpio-backlight";
+		gpios = <&main_gpio1 16 GPIO_ACTIVE_HIGH>; /* P2.36 / X2.8 */
+		default-on;
+	};
+};
+
 &main_pmx0 {
 	pb2_multitool_pru0_pins: pb2-multitool-pru0-pins {
 		pinctrl-single,pins = <
@@ -155,11 +163,47 @@
 		     &pb2_multitool_mcu_short_disable_pins>;
 	clock-frequency = <400000>;
 	status = "okay";
+
+	touchscreen@38 {
+		compatible = "focaltech,ft6336";
+		reg = <0x38>;
+		interrupt-parent = <&main_gpio1>;
+		interrupts = <24 IRQ_TYPE_EDGE_FALLING>; /* P2.05 / X2.13 */
+		touchscreen-size-x = <320>;
+		touchscreen-size-y = <480>;
+		/* X2.11 shares LCD reset; the display performs the reset. */
+	};
 };
 
 &main_spi0 {
 	pinctrl-0 = <&main_spi0_pins_default
 		     &pb2_multitool_spi0_short_disable_pins>;
+
+	display@0 {
+		compatible = "lcdwiki,msp4031", "panel-mipi-dbi-spi";
+		reg = <0>;
+		spi-max-frequency = <32000000>;
+
+		dc-gpios = <&main_gpio1 5 GPIO_ACTIVE_HIGH>; /* P1.23 / X2.5 */
+		reset-gpios = <&main_gpio1 6 GPIO_ACTIVE_HIGH>; /* P1.21 / X2.4, X2.11 */
+		backlight = <&msp4031_backlight>;
+		format = "r5g6b5";
+
+		width-mm = <56>;
+		height-mm = <84>;
+
+		panel-timing {
+			hactive = <320>;
+			vactive = <480>;
+			hback-porch = <0>;
+			vback-porch = <0>;
+			clock-frequency = <0>;
+			hfront-porch = <0>;
+			hsync-len = <0>;
+			vfront-porch = <0>;
+			vsync-len = <0>;
+		};
+	};
 };
 
 &main_spi2 {
-- 
